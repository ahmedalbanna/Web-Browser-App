<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="browser_database" />
        <include domain="database" path="browser_database-shm" />
        <include domain="database" path="browser_database-wal" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="saved_pages/" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="cache" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="browser_database" />
        <include domain="database" path="browser_database-shm" />
        <include domain="database" path="browser_database-wal" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="saved_pages/" />
        <include domain="file" path="downloads/" />
    </device-transfer>
</data-extraction-rules>
