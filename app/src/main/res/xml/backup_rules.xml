<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include Room database and prefs for restore -->
    <include domain="database" path="browser_database" />
    <include domain="database" path="browser_database-shm" />
    <include domain="database" path="browser_database-wal" />
    <include domain="sharedpref" path="." />
    <include domain="file" path="saved_pages/" />
    <!-- Exclude transient / sensitive data -->
    <exclude domain="file" path="downloads/" />
    <exclude domain="cache" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
